rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation
    function isValidSession(session) {
      return session.userId is string 
        && session.totalImagesAttempted is int 
        && session.totalImagesAttempted >= 0 
        && session.totalImagesAttempted <= 250
        && session.correctEntries is int 
        && session.correctEntries >= 0 
        && session.correctEntries <= session.totalImagesAttempted
        && session.averageTimeMs is number 
        && session.averageTimeMs >= 0.0
        && session.averageTimeMs <= 60000.0 // Reasonable speed ceiling
        && session.timestamp == request.time // Enforce server timestamp
        && session.details is list 
        && session.details.size() <= 250
        && (!session.keys().hasAll(['trainingMode']) || (session.trainingMode is string && session.trainingMode.size() <= 32))
        && (!session.keys().hasAll(['operatorId']) || (session.operatorId is string && session.operatorId.size() <= 64))
        && (!session.keys().hasAll(['averageSpeed']) || (session.averageSpeed is number && session.averageSpeed >= 0.0))
        && (!session.keys().hasAll(['accuracy']) || (session.accuracy is number && session.accuracy >= 0.0 && session.accuracy <= 100.0))
        && (!session.keys().hasAll(['level']) || (session.level is string && session.level.size() <= 10));
    }

    function isValidSandboxUser(user) {
      return user.username is string 
        && user.username.size() >= 3 
        && user.username.size() <= 32
        && user.passwordText is string 
        && user.passwordText.size() >= 3 
        && user.passwordText.size() <= 64
        && user.role is string 
        && (user.role == "admin" || user.role == "trainee")
        && user.createdAt is string
        && user.createdAt.size() <= 30;
    }

    function isValidLoginHistory(log) {
      return log.username is string
        && log.username.size() >= 1
        && log.role is string
        && log.success is bool
        && (!log.keys().hasAll(['userAgent']) || log.userAgent is string);
    }

    // Rules for test_sessions collection
    match /test_sessions/{sessionId} {
      allow create: if isValidId(sessionId)
        && isValidSession(request.resource.data);
        
      allow read: if true;
        
      allow update, delete: if true;
    }

    // Rules for login_history collection
    match /login_history/{logId} {
      allow create: if isValidId(logId)
        && isValidLoginHistory(request.resource.data);
        
      allow read: if true;
        
      allow update, delete: if true;
    }

    // Rules for sandbox_users collection
    match /sandbox_users/{username} {
      allow read: if true;
      allow create, update: if isValidId(username)
        && isValidSandboxUser(request.resource.data);
      allow delete: if true;
    }

    // Rules for custom_invoices collection
    match /custom_invoices/{invoiceId} {
      allow read, write: if true;
    }
  }
}
